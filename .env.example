# Copy to `.env` and fill in your key. `npm run demo` auto-loads `.env`.
# Real process env always wins over `.env`; empty values count as absent.
TYPESAFE_API_KEY=sk-your-key-here

# TypeSafe defaults (used when absent):
# CONDENSE_BASE_URL=https://api.typesafe.ai/v1/systemone
# CONDENSE_MODEL=jev-latest

# OpenRouter alternative — uncomment to switch the demo to OpenRouter by editing `.env` only:
# CONDENSE_BASE_URL=https://openrouter.ai/api/alpha/decisions
# CONDENSE_MODEL=~typesafe/jev-latest
